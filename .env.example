# ===== RENDER DEPLOYMENT CONFIGURATION =====
# Configuration for Render deployment

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=<UR URI>

# Flask Service URLs
# URL Phishing Detection Service
FLASK_URL=https://your-flask-service.onrender.com
FLASK_SERVICE_URL=https://your-flask-service.onrender.com

# Text/Message Phishing Detection Service
FLASK_TEXT_URL=https://your-flask-text-service.onrender.com
FLASK_TEXT_SERVICE_URL=https://your-flask-text-service.onrender.com

# Session Secret (use a strong random string - min 32 characters)
SESSION_SECRET=your-very-secure-random-string-at-least-32-chars-long

# Google OAuth for production
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CALLBACK_URL=https://your-app.onrender.com/auth/google/callback

# Port (Render provides this automatically)
PORT=3000

# Model Path
MODEL_PATH=models/phishing_model_optimized.pkl


# ===== LOCALHOST CONFIGURATION (COMMENTED) =====
# Uncomment below for local development

# # MongoDB Connection
# MONGODB_URI=mongodb://localhost:27017/phishguard

# # Flask AI Service URLs
# FLASK_URL=http://localhost:7000
# FLASK_TEXT_URL=http://localhost:5002

# # Session Secret
# SESSION_SECRET=supersecret-change-in-production

# # Google OAuth (optional - for Google login)
# GOOGLE_CLIENT_ID=your-google-client-id-here
# GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# # Node Environment
# NODE_ENV=development

# # Model Path
# MODEL_PATH=models/phishing_model_optimized.pkl
